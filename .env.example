# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=*

# --- sign-in (make deploy-auth) ---
# The Google OAuth web client (README section 14). The secret stays here, in
# the gitignored .env: deploy-auth passes it to CloudFormation as a NoEcho
# parameter, and it never reaches the frontend build.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- weekly report (make deploy-reports) ---
# Verified SES identities: the sender, and - while SES is in the sandbox -
# every recipient. Comma-separate several recipients.
REPORT_SENDER=
REPORT_RECIPIENTS=

# --- agenda parser (make deploy-ai, make parse, make llm-hello) ---
# Gemini model code and thinking level. Defaults: gemini-3.5-flash-lite, low.
PARSER_MODEL=
PARSER_EFFORT=
# Your Gemini API key from Google AI Studio, for LOCAL testing only (make parse /
# make llm-hello). .env is git-ignored; never put the key in .env.example, in a
# NEXT_PUBLIC_* variable or in code. The deployed Lambda reads it from the SSM
# SecureString named below instead (README section 16).
GEMINI_API_KEY=
# Default /peach/gemini-api-key.
GEMINI_API_KEY_PARAMETER=

# --- written by the scripts, not by hand ---
# make deploy-ai: the parser's function URL (NEXT_PUBLIC_PARSER_URL).
PARSER_URL=
# make deploy-auth: public values the frontend is built with. Compose also gives
# the first two to the local backend, which checks meetings API tokens with them.
COGNITO_AUTHORITY=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# make deploy-backend: the function URL. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=
